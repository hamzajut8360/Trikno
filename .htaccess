# TRIKNO - Clean URLs Configuration (.htaccess)
RewriteEngine On
RewriteBase /

# Prevent directory listing
Options -Indexes

# Legacy application redirects
RewriteRule ^en-nuesse-und-fruechte/?$ en/nuesse-und-fruechte [R=301,NC,L]
RewriteRule ^en-freidressieren/?$ en/freidressieren [R=301,NC,L]
RewriteRule ^en-hohlformen/?$ en/hohlformen [R=301,NC,L]

# Special directory conflicts: prioritize the main overview pages
RewriteRule ^news/?$ news.html [NC,L]
RewriteRule ^en/news/?$ en/news.html [NC,L]
RewriteRule ^es/news/?$ es/news.html [NC,L]
RewriteRule ^fr/news/?$ fr/news.html [NC,L]

# 1. Remove .html from browser address bar if user types it directly (301 Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internally route clean URL to existing .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L]
