{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.glb",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.hdr",
      "headers": [
        { "key": "Content-Type", "value": "image/vnd.radiance" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/models/:match*", "destination": "/portal/configurator/assets/models/:match*" },
    { "source": "/assets/thumbs/:match*", "destination": "/portal/configurator/assets/thumbs/:match*" },
    { "source": "/assets/img/:match*", "destination": "/portal/configurator/assets/img/:match*" },
    { "source": "/models/:match*", "destination": "/portal/configurator/assets/models/:match*" },
    { "source": "/draco/:match*", "destination": "/portal/configurator/draco/:match*" }
  ],
  "redirects": [
    { "source": "/en-nuesse-und-fruechte", "destination": "/en/nuesse-und-fruechte", "permanent": true },
    { "source": "/en-freidressieren", "destination": "/en/freidressieren", "permanent": true },
    { "source": "/en-hohlformen", "destination": "/en/hohlformen", "permanent": true },
    { "source": "/en-one-shot", "destination": "/en/one-shot", "permanent": true },
    { "source": "/en-sandwich", "destination": "/en/sandwich", "permanent": true },
    { "source": "/en-coldpress", "destination": "/en/coldpress", "permanent": true },
    { "source": "/en-dekorieren", "destination": "/en/dekorieren", "permanent": true },
    { "source": "/en-biscuits", "destination": "/en/biscuits", "permanent": true },
    { "source": "/en-solid", "destination": "/en/solid", "permanent": true },
    { "source": "/en/en-nuesse-und-fruechte", "destination": "/en/nuesse-und-fruechte", "permanent": true },
    { "source": "/en/en-freidressieren", "destination": "/en/freidressieren", "permanent": true },
    { "source": "/en/en-hohlformen", "destination": "/en/hohlformen", "permanent": true },
    { "source": "/es/en-nuesse-und-fruechte", "destination": "/es/nuesse-und-fruechte", "permanent": true },
    { "source": "/es/en-freidressieren", "destination": "/es/freidressieren", "permanent": true },
    { "source": "/es/en-hohlformen", "destination": "/es/hohlformen", "permanent": true },
    { "source": "/fr/en-nuesse-und-fruechte", "destination": "/fr/nuesse-und-fruechte", "permanent": true },
    { "source": "/fr/en-freidressieren", "destination": "/fr/freidressieren", "permanent": true },
    { "source": "/fr/en-hohlformen", "destination": "/fr/hohlformen", "permanent": true }
  ]
}
